{
  "name": "sqlboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "concurrently \"npm run dev -w packages/api\" \"npm run dev -w packages/web\"",
    "seed": "node packages/api/scripts/seed.cjs",
    "start": "npm run dev -w packages/api"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "concurrently": "^9.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "better-sqlite3@12.11.1": true,
    "duckdb@1.4.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
