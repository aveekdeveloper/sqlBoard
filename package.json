{
  "name": "sqlboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "concurrently \"npm run dev -w packages/api\" \"npm run dev -w packages/web\"",
    "seed": "node packages/api/scripts/seed.cjs",
    "start": "npm run dev -w packages/api"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/react-grid-layout": "^1.3.6",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "better-sqlite3@12.11.1": true,
    "duckdb@1.4.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@databricks/sql": "^2.4.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "lucide-react": "^1.61.0",
    "react-grid-layout": "^1.5.4",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.7",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "snowflake-sdk": "^3.4.1",
    "zod-to-json-schema": "^3.25.2"
  }
}
