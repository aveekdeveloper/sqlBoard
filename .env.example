# Copy to .env and fill in before `docker compose up`
# Leave DATABASE_URL unset to use a local SQLite file (libSQL with file: URL).
# Set it to a libSQL server URL for production: libsql://sqld:8080
DATABASE_URL=
LIBSQL_AUTH_TOKEN=
SECRET_KEY=change-me-to-a-long-random-string
CACHE_TTL_MINUTES=5
MAX_CACHE_ROWS=10000
QUERY_TIMEOUT_MS=30000
CORS_ORIGIN=
