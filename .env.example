# Copy to .env and fill in before `docker compose up`
# Postgres password used by the bundled `postgres` service. The app's
# DATABASE_URL is derived from it in docker-compose.yml.
POSTGRES_PASSWORD=change-me-to-a-strong-password
SECRET_KEY=change-me-to-a-long-random-string
TENANCY_ENABLED=false
# Leave BASE_DOMAIN empty for localhost-only use.
BASE_DOMAIN=
CACHE_TTL_MINUTES=5
MAX_CACHE_ROWS=10000
QUERY_TIMEOUT_MS=30000
CORS_ORIGIN=

# Running the API outside Docker (`npm run dev`)? Leave DATABASE_URL unset to
# use a local SQLite file (libSQL with a file: URL). To use a libSQL server
# instead, set:
# DATABASE_URL=http://127.0.0.1:8080
# LIBSQL_AUTH_TOKEN=
